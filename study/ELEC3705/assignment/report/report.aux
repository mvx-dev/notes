\def\@LN@column{1}
\newlabel{fig:q8-exp-1}{{5a}{6}{The Larmor precession of the centre column. The expectation value of $\mathbf {I}_z$ is constant, whilst the expectation values of $\mathbf {I}_x$ and $\mathbf {I}_y$ both oscillates at the Larmor frequency. This is because the magnetic field applied in part 1.7 was on resonance with this column's spin, and so it perfectly prepared it in this state}{figure.caption.5}{}}
\newlabel{sub@fig:q8-exp-1}{{a}{6}{The Larmor precession of the centre column. The expectation value of $\mathbf {I}_z$ is constant, whilst the expectation values of $\mathbf {I}_x$ and $\mathbf {I}_y$ both oscillates at the Larmor frequency. This is because the magnetic field applied in part 1.7 was on resonance with this column's spin, and so it perfectly prepared it in this state}{figure.caption.5}{}}
\newlabel{fig:q8-exp-2}{{5b}{6}{The Larmor precession of the column 10 places to the right of the centre column. There is still a small amount of precessing around the $z$-axis, however even so close to the centre column it is still far enough away from resonance to have the expectation value of $\mathbf {I}_z$ to be $-0.5$}{figure.caption.5}{}}
\newlabel{sub@fig:q8-exp-2}{{b}{6}{The Larmor precession of the column 10 places to the right of the centre column. There is still a small amount of precessing around the $z$-axis, however even so close to the centre column it is still far enough away from resonance to have the expectation value of $\mathbf {I}_z$ to be $-0.5$}{figure.caption.5}{}}
\newlabel{fig:q8-exp-3}{{5c}{6}{The Larmor precession of the right-most column. This column is the furthest from resonance, so the precession is the weakest. The expectation value of $\mathbf {I}_z$ is still at $-0.5$}{figure.caption.5}{}}
\newlabel{sub@fig:q8-exp-3}{{c}{6}{The Larmor precession of the right-most column. This column is the furthest from resonance, so the precession is the weakest. The expectation value of $\mathbf {I}_z$ is still at $-0.5$}{figure.caption.5}{}}
